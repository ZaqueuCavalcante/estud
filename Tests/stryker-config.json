{
    "stryker-config":
    {
        "solution": "../Estud.slnx",
        "project": "Back.csproj",
        "test-runner": "vstest",
        "mutation-level": "Complete",
        "coverage-analysis": "perTest",
        "concurrency": 1,
        "additional-timeout": 10000,
        "break-on-initial-test-failure": true,
        "reporters": [ "html", "json", "dots" ],
        "thresholds": { "high": 80, "low": 60, "break": 0 },
        "mutate": [
            "**/Commands/*.cs",
            "**/Domain/**/*.cs",
            "**/Extensions/**/*.cs",
            "**/Features/**/*Service.cs",
            "!**/Domain/Enums/**",
            "!**/*Config.cs"
        ],
        "ignore-methods": [
            "*GetExamples*",
            "*ToString*",
            "*Dispose*",
            "*Log*"
        ]
    }
}
