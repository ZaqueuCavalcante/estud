{
    "stryker-config":
    {
        "solution": "../Estud.slnx",
        "project": "Back.csproj",
        "test-runner": "vstest",
        "mutation-level": "Complete",
        "coverage-analysis": "perTest",
        "concurrency": 1,
        "additional-timeout": 10000,
        "break-on-initial-test-failure": true,
        "reporters": [ "html", "json", "dots" ],
        "thresholds": { "high": 80, "low": 60, "break": 0 },
        "mutate": [
            "**/Commands/*.cs",
            "**/Domain/**/*.cs",
            "**/Extensions/**/*.cs",
            "**/Features/**/AssignStudentToClass/*Service.cs",
            "**/Features/**/CreateCalendarDay/*Service.cs",
            "**/Features/**/CreateClassActivity/*Service.cs",
            "**/Features/**/CreateClassActivityWorkEntry/*Service.cs",
            "**/Features/**/CreateCourseOffering/*Service.cs",
            "**/Features/**/CreateLessonAttendance/*Service.cs",
            "**/Features/**/FinalizeClass/*Service.cs",
            "**/Features/**/GetCampi/*Service.cs",
            "**/Features/**/GetCampusOccupancy/*Service.cs",
            "**/Features/**/GetClass/*Service.cs",
            "**/Features/**/GetClasses/*Service.cs",
            "**/Features/**/GetClassroom/*Service.cs",
            "**/Features/**/GetDisciplineDetails/*Service.cs",
            "**/Features/**/GetStudentAttendanceCalendar/*Service.cs",
            "**/Features/**/GetStudentClass/*Service.cs",
            "**/Features/**/GetStudentClassActivity/*Service.cs",
            "**/Features/**/GetStudentDetails/*Service.cs",
            "**/Features/**/GetStudents/*Service.cs",
            "**/Features/**/GetTeacherClass/*Service.cs",
            "**/Features/**/GetTeacherClassActivity/*Service.cs",
            "**/Features/**/GetTeacherClassLesson/*Service.cs",
            "**/Features/**/GoogleOneTapLogin/*Service.cs",
            "**/Features/**/UpdateCampusOpeningHours/*Service.cs",
            "**/Features/**/UpdateClassActivity/*Service.cs",
            "**/Features/**/UpdateClassSchedules/*Service.cs",
            "**/Features/**/UpdateRole/*Service.cs",
            "**/Features/**/VerifySsoDomain/*Service.cs",
            "!**/Domain/Enums/**",
            "!**/*Config.cs"
        ],
        "ignore-methods": [
            "*GetExamples*",
            "*ToString*",
            "*Dispose*",
            "*Log*",
            "WithError",
            "When"
        ]
    }
}
