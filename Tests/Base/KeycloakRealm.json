{
  "realm": "estud",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "estud",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "estud-keycloak-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5100/identity/sso/callback/*"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ]
}
