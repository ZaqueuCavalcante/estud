FROM mcr.microsoft.com/dotnet/sdk:10.0 AS schema

RUN dotnet tool install --global dotnet-ef --version 10.0.10
ENV PATH="$PATH:/root/.dotnet/tools"

WORKDIR /src
COPY . .

RUN dotnet restore "./Back/Back.csproj"
RUN dotnet ef dbcontext script --project Back/Back.csproj --configuration Release -o /schema.sql

FROM postgres:18-alpine

# O initdb só roda esse script quando o volume está vazio: depois de mudar o schema, recriar com `docker compose down -v`.
COPY --from=schema /schema.sql /docker-entrypoint-initdb.d/estud.sql
